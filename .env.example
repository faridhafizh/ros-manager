# Leave ROS_HOST empty to discover MikroTik routers on the local network.
# For automatic discovery, enable www-ssl (recommended) on RouterOS v7.
# ROS_HOST=https://192.168.100.1
# Only change to http if you have enabled the unencrypted www service.
# ROS_SCHEME=http
ROS_USER=admin
ROS_PASS=
# Only if the router uses a self-signed certificate:
# NODE_TLS_REJECT_UNAUTHORIZED=0
